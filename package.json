{
  "name": "brightloop-subscription-backend",
  "version": "1.0.0",
  "description": "Brightloop Software Subscription Management & Recurring Billing Engine (Odoo x Flux Hackathon)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
